{
    "base": [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "BACK"],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "[", "]", "\\"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", ";", "'", "ENTER"],
