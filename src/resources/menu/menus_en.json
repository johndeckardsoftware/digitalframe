{
    "menu": [
        {"t": "Keyboard Help", "k": "KEY_F1"},
        {"t": "Remote Help", "k": "KEY_F2"},
        {"t": "Pause", "k": "KEY_F3"},
        {"t": "Previous", "k": "KEY_F4"},
        {"t": "Next", "k": "KEY_F5"},
        {"t": "Sleep", "k": "KEY_F7"},
        {"t": "Wake Up", "k": "KEY_F8"},
        {"g": "f'Ambient Light ({self.on_off(self.df.ambient_light)})'", "k": "KEY_L"},
        {"t": "Light Settings", "m": "light"},
        {"g": "f'Folder ({self.df.items.get_subfolder()})'", "m": "folders"},
        {"g": "f'Matte ({Config.get(\"items.types.image.matte.texture\", None)})'", "m": "mattes"},
        {"g": "f'Border ({Config.get(\"items.types.image.border.file\", None)})'", "m": "borders"},
        {"e": "f'Display time < {self.df.image_ttl} > sec.'",
         "fl": "self.devices.set_ttl(-10)", "fr": "self.devices.set_ttl(10)", "fv": "self.devices.set_ttl(self.number, delta=False)"},
        {"e": "f'Sleep after < {self.df.hdmi_off_timeout} > min.'",
         "fl": "self.devices.set_sleep(-5)", "fr": "self.devices.set_sleep(5)", "fv": "self.devices.set_sleep(self.number, delta=False)"},
        {"g": "f'Shuffle playback ({self.on_off(self.df.items.get_shuffle())})'", "k": "KEY_S"},
        {"t": "Metadata", "m": "meta"},
        {"t": "Clock", "k": "KEY_C"},
        {"t": "Extensions", "m": "plugins"},
        {"t": "Other Tools", "m": "debug"}
    ],
    "menu_sel": 0,
    "light": [
        {"e": "f'Light Adjustment < {self.df.lux_adj} >'",
         "fl": "self.df.set_lux_adj(-self.devices.inc_value)",
         "fr": "self.df.set_lux_adj(self.devices.inc_value)",
         "fv": "self.df.set_lux_adj(self.number, delta=False)"},
        {"e": "f'Brightness < {self.df.get_brightness()} > (with Ambient light disabled)'",
         "fl": "self.devices.set_lux(-1)",
         "fr": "self.devices.set_lux(1)",
         "fv": "self.devices.set_lux(self.number, delta=False)"},
        {"e": "f'Light angle direction < {self.df.shader.config_get('uDirection')} > (only for \"light_gradient\" shader)'",
         "fl": "self.devices.set_direction(-1)", "fr": "self.devices.set_direction(1)"},
        {"e": "f'Monitor brightness < {ddcutil.get_vcp_value(ddcutil.BRIGHTNESS)} >'",
         "fl": "self.devices.set_monitor_brightness(-1)", "fr": "self.devices.set_monitor_brightness(1)"},
        {"e": "f'Monitor contrast < {ddcutil.get_vcp_value(ddcutil.CONTRAST)} >'",
         "fl": "self.devices.set_monitor_contrast(-1)", "fr": "self.devices.set_monitor_contrast(1)"},
        {"e": "f'Increment step < {self.devices.inc_value} >'",
         "fl": "self.devices.set_increment(-1)",
         "fr": "self.devices.set_increment(1)",
         "fv": "self.devices.set_increment(self.number, delta=False)"},
        {"t": "Back", "back": true, "m": "menu"}
    ],
    "light_sel": 0,
    "light_width": 1200,
    "meta": [
        {"g": "f'Title ({self.df.items.get_show_text(\"title\")})'", "k": "KEY_ONE"},
        {"g": "f'Caption ({self.df.items.get_show_text(\"caption\")})'", "k": "KEY_TWO"},
        {"g": "f'Name ({self.df.items.get_show_text(\"name\")})'", "k": "KEY_THREE"},
        {"g": "f'Date ({self.df.items.get_show_text(\"date\")})'", "k": "KEY_FOUR"},
        {"g": "f'Location ({self.df.items.get_show_text(\"location\")})'", "k": "KEY_FIVE"},
        {"g": "f'Directory ({self.df.items.get_show_text(\"directory\")})'", "k": "KEY_SIX"},
        {"t": "Reset metadata", "k": "KEY_ZERO"},
        {"t": "Back", "back": true, "m": "menu"}
    ],
    "meta_sel": 0,
    "debug": [
        {"t": "Filter", "k": "CTRL+KEY_Q"},
        {"g": "f'Edit Filter ({self.df.items.get_filter()})'", "vk": true, "d": "f'{self.df.items.get_filter()}'", "f": "self.df.set_tags_filter(self.osk.typed_text)"},
        {"e": "f'Voice quality < {Config.get(\"voice.threshold\", 70)} >'",
         "fl": "self.devices.set_voice_threshold(-5)",
         "fr": "self.devices.set_voice_threshold(5)",
         "fv": "self.devices.set_voice_threshold(self.number, delta=False)"},
        {"t": "Diagnostics", "k": "CTRL+KEY_D"},
        {"t": "System Diagnostics", "k": "CTRL+KEY_M"},
        {"t": "Frames Per Second", "k": "CTRL+KEY_F"},
        {"t": "Screen Size", "k": "KEY_F11"},
        {"t": "Private", "k": "KEY_F6"},
        {"t": "Save configuration", "f": "Config.save()"},
        {"t": "Close", "f": "self.df.close(False)"},
        {"t": "Close and Save configuration", "k": "CTRL+KEY_E"},
        {"t": "Reload", "f": "self.df.reload(False)"},
        {"t": "Reload and Save configuration", "f": "self.df.reload()"},
        {"t": "Reboot", "f": "self.df.reboot()"},
        {"t": "Power off", "f": "self.df.power_down()"},
        {"t": "Back", "back": true, "m": "menu"}
    ],
    "debug_sel": 0,
    "plugins": [
        {"t": "Back", "back": true, "m": "menu"}
    ],
    "plugins_sel": 0,

    "extra": [
        {"t": "pause", "f": "self.df.set_paused(True)"},
        {"t": "continue", "f": "self.df.set_paused(False)"},
        {"t": "forward", "k": "KEY_F5"},
        {"t": "next", "k": "KEY_F5"},
        {"t": "previous", "k": "KEY_F4"},
        {"t": "options", "f": "self.df.devices.keyboard(self.df.devices.key_kb_menu)"},
        {"t": "menu", "f": "self.df.devices.keyboard(self.df.devices.key_kb_menu)"},
        {"t": "stop", "f": "'stop'"}
    ],

    "action_selection_word": [
        ["increase", "fr"],
        ["decrease", "fl"],
        ["by", "fv"]
    ],

    "pre_action_selection_word": [
        ["use negative number", "fm"],
        ["use number", "fn"],
        ["use minus", "fm"],
        ["use", "fn"],
        ["select", "fs"],
        ["set", "fs"]
    ]
}